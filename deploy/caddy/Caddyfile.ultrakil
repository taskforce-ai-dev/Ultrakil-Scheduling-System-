# UltraKIL staging site fragment for Caddy v2.6.2+. It contains no global
# options and can be safely imported by an existing host Caddyfile.
(ultrakil_security_headers) {
	# HSTS deliberately applies only to each served host. Do not add
	# includeSubDomains or preload until every sibling hostname is TLS-ready.
	header {
		-Server
		-X-Powered-By
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# Dispatch Board writes its share payload, and the browser acceptance path
		# reads it back to prove the rendered payload. Keep both capabilities scoped
		# to this origin rather than disabling clipboard reads globally.
		Permissions-Policy "accelerometer=(), autoplay=(), camera=(), clipboard-read=(self), clipboard-write=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), web-share=(), xr-spatial-tracking=()"
		# Next's current production bundle needs inline styles and evaluator-backed
		# development/runtime compatibility. This reports violations first; it does
		# not yet block requests until browser evidence supports enforcement.
		Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://ultrakil-api.taskforceai.tech https://api.ultrakil.taskforceai.tech; manifest-src 'self'; media-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests"
	}
}

ultrakil.taskforceai.tech {
	import ultrakil_security_headers
	encode zstd gzip
	reverse_proxy 127.0.0.1:3000
}

# Keep both API hostnames during the staged cutover: the portal build embeds
# its API base URL and older approved builds may still use api.ultrakil.
api.ultrakil.taskforceai.tech {
	import ultrakil_security_headers
	encode zstd gzip
	reverse_proxy 127.0.0.1:3001
}

ultrakil-api.taskforceai.tech {
	import ultrakil_security_headers
	encode zstd gzip
	reverse_proxy 127.0.0.1:3001
}
