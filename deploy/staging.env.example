# Copy to deploy/staging.env on the staging host. Never commit that real file.
COMPOSE_PROJECT_NAME=ultrakil-staging
POSTGRES_USER=ultrakil
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=ultrakil_staging
DATABASE_URL=postgresql://ultrakil:replace-with-url-encoded-password@postgres:5432/ultrakil_staging?schema=public

REDIS_PASSWORD=replace-with-a-different-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
SEED_ADMIN_EMAIL=replace-with-admin@example.invalid
SEED_ADMIN_PASSWORD=replace-with-a-long-random-admin-password
SEED_ADMIN_NAME=UltraKIL Staging Administrator

# These must be reachable from the manager's browser. HTTPS URLs are required
# before anyone outside the internal pilot network uses staging.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
API_CORS_ORIGINS=http://localhost:3000

API_BIND_ADDRESS=127.0.0.1
API_PORT=3001
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000

# Absolute host path containing the two normalized workbook names documented
# in STAGING_RUNBOOK.md. Only the import runner mounts the approved files.
IMPORT_DIR=/opt/ultrakil/import
IMPORT_CONFIG_DIR=/opt/ultrakil/import-config
IMPORT_REPORT_DIR=/opt/ultrakil/import-reports
# Set these to the numeric owner of the private directories; never use 0.
IMPORT_UID=1000
IMPORT_GID=1000
SCHEDULER_MEMORY_LIMIT=1280m
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
# Private 0700 directory, owned by the image's fixed recovery UID/GID 10001.
BACKUP_DIR=/opt/ultrakil/backups
# Daily schedule plus a two-hour grace. Alert on an unhealthy backup service.
BACKUP_MAX_AGE_SECONDS=93600

# Optional `offhost` profile: disabled until destination/key custody are approved.
# The age DECRYPTION identity belongs in a separate recovery vault, never here.
EXPORT_AGE_RECIPIENT=
EXPORT_SSH_HOST=
EXPORT_SSH_PORT=22
EXPORT_SSH_USER=
EXPORT_REMOTE_DIR=
EXPORT_WORK_DIR=/opt/ultrakil/export-work
EXPORT_SSH_KEY_PATH=/opt/ultrakil/export-secrets/ssh-key
EXPORT_KNOWN_HOSTS_PATH=/opt/ultrakil/export-secrets/known-hosts
