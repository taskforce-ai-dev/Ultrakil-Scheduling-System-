# Vercel variable-name checklist only. Enter real values in the dashboard.
# Configure this same set twice: branch-specific Preview values for the
# long-lived staging branch, and separate Production values for main.

# apps/api
NODE_ENV=production
DATABASE_URL=
SCHEDULE_DISPATCHER=qstash
SCHEDULE_EXECUTION_BUDGET_SECONDS=55
API_PUBLIC_URL=https://YOUR_API_ENVIRONMENT_DOMAIN.vercel.app
API_PORT=3000
API_GLOBAL_PREFIX=api
API_CORS_ORIGINS=https://YOUR_MANAGER_ENVIRONMENT_DOMAIN.vercel.app
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
SCHEDULER_BASE_URL=https://YOUR_SCHEDULER_ENVIRONMENT_DOMAIN.vercel.app
SCHEDULER_HEALTH_TIMEOUT_MS=2000
SCHEDULER_API_TOKEN=
HEALTH_PROBE_TIMEOUT_MS=2000
JWT_SECRET=
JWT_EXPIRES_IN=12h
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# apps/manager-web
NEXT_PUBLIC_API_BASE_URL=https://YOUR_API_ENVIRONMENT_DOMAIN.vercel.app/api

# services/scheduler
# Use the same value as apps/api/SCHEDULER_API_TOKEN.
SCHEDULER_API_TOKEN=

# Never set SCHEDULER_ALLOW_UNAUTHENTICATED on Vercel.
