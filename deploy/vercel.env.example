# Vercel project variables — enter values in each project's Vercel dashboard.
# This file intentionally contains no credentials or database connection data.
# Keep production URLs stable: use each project's production .vercel.app domain,
# not a branch or deployment URL.

# apps/api
NODE_ENV=production
DATABASE_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
BULLMQ_PREFIX=ultrakil
API_PORT=3000
API_GLOBAL_PREFIX=api
API_CORS_ORIGINS=https://YOUR_MANAGER_PROJECT.vercel.app
SCHEDULER_BASE_URL=https://YOUR_SCHEDULER_PROJECT.vercel.app
SCHEDULER_HEALTH_TIMEOUT_MS=2000
SCHEDULER_API_TOKEN=
HEALTH_PROBE_TIMEOUT_MS=2000
JWT_SECRET=
JWT_EXPIRES_IN=12h
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=

# apps/manager-web
NEXT_PUBLIC_API_BASE_URL=https://YOUR_API_PROJECT.vercel.app/api

# services/scheduler (same shared value as apps/api/SCHEDULER_API_TOKEN)
SCHEDULER_API_TOKEN=
