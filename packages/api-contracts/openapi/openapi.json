  "info": {
    "title": "UltraKIL Scheduling API",
    "description": "Phase 1 pilot API for UltraKIL scheduling and dispatching.\n\nHard rules enforced by this API:\n- Colombo staff serve Colombo work only; Kandy staff serve Kandy work only.\n- Permanently stationed staff are never moved away from their site.\n- Every job carries at least one PMS-grade supervisor.\n- A vehicle may only be driven by an employee authorised for it.\n- Allowed service days are hard constraints; preferred days are preferences.\n\nWork that cannot satisfy every hard rule stays in the Unassigned queue\nwith an explanation. Hard rules are never relaxed to fill a schedule.\n\nErrors always carry a stable `code`. Clients must branch on `code`,\nnever on `message`.\n\nEvery endpoint requires a bearer token except sign-in, the health\nprobes and /meta.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "Sign in and session"
    },
    {
      "name": "health",
      "description": "Liveness and readiness probes"
    },
    {
      "name": "meta",
      "description": "Shared vocabulary: enums, grades and error codes"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Local development"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Sign in via POST /api/auth/login, then paste the accessToken here."
      }
    },
    "schemas": {
      "AuthenticatedUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "admin@taskforceai.tech"
          },
          "fullName": {
            "type": "string",
            "example": "UltraKIL Administrator"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "MANAGER"
            ],
            "example": "MANAGER"
          }
        },
        "required": [
          "id",
          "email",
          "fullName",
          "role"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Send as `Authorization: Bearer <token>` on every request."
          },
          "expiresIn": {
            "type": "string",
            "example": "12h"
          },
          "user": {
            "$ref": "#/components/schemas/AuthenticatedUserDto"
          }
        },
        "required": [
          "accessToken",
          "expiresIn",
          "user"
        ]
      },
      "LivenessResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ],
            "example": "ok"
          },
          "checkedAt": {
            "type": "string",
            "example": "2026-08-24T04:15:00.000Z"
          }
        },
        "required": [
          "status",
          "checkedAt"
        ]
      },
      "DependencyHealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ],
            "example": "up",
            "description": "Whether this dependency answered its probe."
          },
          "responseTimeMs": {
            "type": "number",
            "description": "Round-trip time of the probe, in milliseconds.",
            "example": 4
          },
          "code": {
            "type": "string",
            "description": "Stable error code when the dependency is down.",
            "example": "DATABASE_UNAVAILABLE"
          },
          "message": {
            "type": "string",
            "description": "Actionable explanation of how to fix it.",
            "example": "Cannot reach PostgreSQL. Start it with \"pnpm dev:infra\" and confirm DATABASE_URL in your .env."
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "description": "Probe-specific extra information."
          }
        },
        "required": [
          "status"
        ]
      },
      "HealthResponseDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "example": "ok",
            "description": "\"ok\" when every dependency is up; \"degraded\" when at least one is down. A degraded result is served with HTTP 503."
          },
          "checkedAt": {
            "type": "string",
            "example": "2026-08-24T04:15:00.000Z"
          },
          "uptimeSeconds": {
            "type": "number",
            "example": 1423.5,
            "description": "Process uptime in seconds."
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/DependencyHealthDto"
            },
            "description": "One entry per checked dependency: \"database\", \"queue\" and \"scheduler\"."
          }
        },
        "required": [
          "status",
          "checkedAt",
          "uptimeSeconds",
          "dependencies"
        ]
      },
      "MetaResponseDto": {
        "type": "object",
        "properties": {
          "apiVersion": {
            "type": "string",
            "example": "0.1.0",
            "description": "API package version."
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Colombo",
            "description": "Timezone all scheduling dates and service windows are expressed in."
          },
          "branchCodes": {
            "example": [
              "COLOMBO",
              "KANDY"
            ],
            "description": "Branches. Staff may only serve work in their own branch — this is a hard rule.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "weekdays": {
            "example": [
              "MONDAY",
              "TUESDAY"
            ],
            "description": "Weekday vocabulary used by allowed and preferred day rules.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pmsGradeLabels": {
            "example": [
              "Senior PMS",
              "PMS",
              "Assistant PMS",
              "SPMS",
              "APMS"
            ],
            "description": "Grades that satisfy the \"every job needs at least one PMS-grade supervisor\" rule.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "frequencyUnits": {
            "type": "object",
            "example": {
              "WEEK": "visits per week",
              "MONTH": "visits per month"
            },
            "description": "Frequency units available on a service agreement.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "errorCodes": {
            "example": [
              "VALIDATION_FAILED",
              "NO_PMS_SUPERVISOR_AVAILABLE"
            ],
            "description": "Every stable error code the API can return. Clients must branch on these, never on message text.",
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "apiVersion",
          "timezone",
          "branchCodes",
          "weekdays",
          "pmsGradeLabels",
          "frequencyUnits",
          "errorCodes"
        ]
      }
    }
  }
}
