          },
          "422": {
            "description": "PERMANENT_SITE_REQUIRED — a stationed employee must name a site."
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Add an employee",
        "tags": [
          "workforce"
        ]
