{
  "name": "@ultrakil/api-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared UltraKIL API contract: OpenAPI document and generated TypeScript types",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.json": "./openapi/openapi.json"
  },
  "files": [
    "src",
    "openapi"
  ],
  "scripts": {
    "generate": "openapi-typescript ./openapi/openapi.json --output ./src/generated/api.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json --emitDeclarationOnly --declarationDir dist"
  },
  "devDependencies": {
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.6.3"
  }
}
