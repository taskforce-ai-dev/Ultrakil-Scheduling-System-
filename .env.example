# =============================================================================
# UltraKIL Phase 1 — example environment file
# Copy to .env and fill in local values.  NEVER commit a real .env file.
# =============================================================================

# --- Shared ------------------------------------------------------------------
NODE_ENV=development
TZ=Asia/Colombo

# --- PostgreSQL (docker compose service: postgres) ---------------------------
POSTGRES_USER=ultrakil
POSTGRES_PASSWORD=ultrakil_local_dev
POSTGRES_DB=ultrakil
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ultrakil:ultrakil_local_dev@localhost:5432/ultrakil?schema=public

# --- Redis / BullMQ (docker compose service: redis) --------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
BULLMQ_PREFIX=ultrakil

# --- Schedule-run dispatch ---------------------------------------------------
# Keep BullMQ for self-hosted deployments. Vercel uses QStash and does not
# create a Redis/BullMQ connection in that mode.
SCHEDULE_DISPATCHER=bullmq
# The checked-in Vercel compatibility cap is 60 seconds. QStash uses 55,
# leaving five seconds for the API response; solver, transport and persistence
# reserves are enforced in code.
SCHEDULE_EXECUTION_BUDGET_SECONDS=55
# Required only when SCHEDULE_DISPATCHER=qstash. This must be the public API
# origin (without the /api prefix); never commit the real token or signing keys.
API_PUBLIC_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Optional daily Vercel Cron fallback for dispatch reconciliation. Set a random
# value of at least 32 characters in Vercel; QStash-signed schedules need none.
CRON_SECRET=

# --- NestJS API (apps/api) ---------------------------------------------------
API_PORT=3001
API_GLOBAL_PREFIX=api
API_CORS_ORIGINS=http://localhost:3000
# Hard ceiling on each dependency probe, so /api/health/ready always answers.
HEALTH_PROBE_TIMEOUT_MS=2000

# --- Authentication ----------------------------------------------------------
# Signing secret for portal access tokens. At least 32 characters.
# REQUIRED in production. Leave it unset locally and the API generates a random
# one at boot (you will be signed out whenever it restarts).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# The first admin account, created on `pnpm db:seed` when no user exists yet.
# The default password is rejected in production.
SEED_ADMIN_EMAIL=admin@taskforceai.tech
SEED_ADMIN_PASSWORD=ultrakil-change-me
SEED_ADMIN_NAME=UltraKIL Administrator

# --- Python scheduling service (services/scheduler) --------------------------
SCHEDULER_PORT=8000
SCHEDULER_BASE_URL=http://localhost:8000
SCHEDULER_HEALTH_TIMEOUT_MS=2000
# Optional locally; required in production when the scheduler is public.
SCHEDULER_API_TOKEN=
# The native development launcher is loopback-only. Never set this for a
# public deployment; Vercel and other public runtimes require the token.
SCHEDULER_ALLOW_UNAUTHENTICATED=true

# --- Manager portal (apps/manager-web, owned by Oshadi) ----------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# --- Workforce import --------------------------------------------------------
# Path to the UltraKIL technician matrix workbook used by the seed importer.
# The real workbook is NOT committed (see data/README.md).
TECHNICIAN_MATRIX_PATH=./data/technician-matrix.xlsx

# --- Visit generation --------------------------------------------------------
# VISIT_GENERATION_DAILY_CAP is a reference visit count shown to managers for
# context only. What generation, the load guard and the optimizer actually
# plan against is computed per branch per day from real employee headcount,
# PMS-grade supervision and vehicle/driver availability (see
# apps/api/src/scheduling/visit-generation/branch-day-capacity.ts) —
# available headcount times VISIT_GENERATION_EMPLOYEE_WORKDAY_MINUTES.
# Generation moves unbooked work off any day that would exceed it; dates
# already booked with a customer are kept and reported instead.
# VISIT_GENERATION_DAILY_CAPACITY_MINUTES is used only as a fallback for a
# branch this database has no workforce imported for at all.
VISIT_GENERATION_DAILY_CAP=12
VISIT_GENERATION_DAILY_CAPACITY_MINUTES=720
VISIT_GENERATION_EMPLOYEE_WORKDAY_MINUTES=480
