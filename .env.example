# =============================================================================
# UltraKIL Phase 1 — example environment file
# Copy to .env and fill in local values.  NEVER commit a real .env file.
# =============================================================================

# --- Shared ------------------------------------------------------------------
NODE_ENV=development
TZ=Asia/Colombo

# --- PostgreSQL (docker compose service: postgres) ---------------------------
POSTGRES_USER=ultrakil
POSTGRES_PASSWORD=ultrakil_local_dev
POSTGRES_DB=ultrakil
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ultrakil:ultrakil_local_dev@localhost:5432/ultrakil?schema=public

# --- Redis / BullMQ (docker compose service: redis) --------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
BULLMQ_PREFIX=ultrakil

# --- NestJS API (apps/api) ---------------------------------------------------
API_PORT=3001
API_GLOBAL_PREFIX=api
API_CORS_ORIGINS=http://localhost:3000
# Hard ceiling on each dependency probe, so /api/health/ready always answers.
HEALTH_PROBE_TIMEOUT_MS=2000

# --- Authentication ----------------------------------------------------------
# Signing secret for portal access tokens. At least 32 characters.
# REQUIRED in production. Leave it unset locally and the API generates a random
# one at boot (you will be signed out whenever it restarts).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# The first admin account, created on `pnpm db:seed` when no user exists yet.
# The default password is rejected in production.
SEED_ADMIN_EMAIL=admin@taskforceai.tech
SEED_ADMIN_PASSWORD=ultrakil-change-me
SEED_ADMIN_NAME=UltraKIL Administrator

# --- Python scheduling service (services/scheduler) --------------------------
SCHEDULER_PORT=8000
SCHEDULER_BASE_URL=http://localhost:8000
SCHEDULER_HEALTH_TIMEOUT_MS=2000

# --- Manager portal (apps/manager-web, owned by Oshadi) ----------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# --- Workforce import --------------------------------------------------------
# Path to the UltraKIL technician matrix workbook used by the seed importer.
# The real workbook is NOT committed (see data/README.md).
TECHNICIAN_MATRIX_PATH=./data/technician-matrix.xlsx
