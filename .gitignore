# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Environment — never commit real secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Prisma
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# Test / coverage
coverage/
.nyc_output/
junit.xml

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local workforce data — real staff data must not be committed
data/*.xlsx
data/*.xls
data/*.csv
# The live mapping names real sites and their branches; only the template is
# committed.
data/matrix-mapping.json
data/job-types.json
# The schedule import report quotes real customer and site names back at you.
data/master-schedule-import-report.json
!data/README.md
!data/*.example.json

# Generated by `next dev` on every run — see next.config.ts `agentRules`.
# Not ignoring these means they turn up untracked in everyone's git status and
# eventually get committed by accident.
apps/manager-web/AGENTS.md
apps/manager-web/CLAUDE.md

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Playwright output (screenshots, videos, traces, the HTML report, the saved
# login for e2e runs — that one holds a real access token). Kept outside
# apps/manager-web deliberately: `next dev`'s file watcher covers that whole
# tree, and a run writing files inside it triggers a Fast Refresh rebuild per
# file, which fights the very dev server the suite is testing against. See
# the note in apps/manager-web/playwright.config.ts.
/.playwright-artifacts/
