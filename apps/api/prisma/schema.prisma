// =============================================================================
// UltraKIL Phase 1 — data model
//
// Design rules encoded here (see docs/DATA_MODEL.md for the narrative version):
//  * Every entity uses a stable UUID primary key and created/updated timestamps.
//  * Branch separation (Colombo / Kandy) is carried on every operational row so
//    the eligibility engine (ULK-C05) can filter without multi-hop joins.
//  * A vehicle checkmark in the workforce matrix means "authorised to drive".
//    There is deliberately no ownership or primary-driver concept.
//  * Values imported from the workforce matrix keep their source spelling in
//    `*Label` / `sourceKey` columns so nothing is silently normalised away.
//  * Phase 2 (PMS tablet, worker app, notifications) is not built here, but
//    Assignment carries acknowledgement/completion timestamps and AuditEvent is
//    generic, so those features can be added without reshaping Phase 1 data.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// UltraKIL operates two branches. Staff may only serve work in their own branch.
enum BranchCode {
  COLOMBO
  KANDY
}

/// How confidently the system knows which branch serves a site. The master
/// schedule names locations, not UltraKIL branches, so an address match is
/// useful evidence but not a manager confirmation.
enum SiteBranchConfidence {
  MATCHED
  UNCERTAIN
  CONFIRMED
}

/// Where the site branch decision came from. Kept separately from confidence
/// so a fallback can never be displayed as a fact merely because it has a
/// concrete BranchCode value.
enum SiteBranchSource {
  ADDRESS_MATCH
  FALLBACK_DEFAULT
  MANAGER_CONFIRMED
}

/// Provenance for values whose source may be a workbook, evidence derived from
/// it, a safe fallback, or a manager's explicit confirmation. UNKNOWN keeps
/// this migration additive for rows created before provenance was recorded.
enum DataProvenance {
  UNKNOWN
  SOURCE
  DERIVED
  DEFAULTED
  MANAGER_CONFIRMED
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

/// Whether an employee can be dispatched to varying sites, or is permanently
/// stationed at one customer site and may not be moved away from it.
enum DeploymentType {
  MOBILE
  PERMANENTLY_STATIONED
}

/// Frequency is expressed as N visits per week or per month.
enum FrequencyUnit {
  WEEK
  MONTH
}

/// Allowed days are hard constraints; preferred days are soft preferences.
enum DayRuleKind {
  ALLOWED
  PREFERRED
}

/// Lifecycle of a service agreement.
///
/// PAUSED is not the same as ARCHIVED: a paused agreement stops generating
/// visits but is expected back, while an archived one is finished and kept
/// only because past visits still reference it. Neither is a deletion —
/// generated visits must always be explainable.
enum AgreementStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum VisitStatus {
  PENDING
  SCHEDULED
  UNASSIGNED
  COMPLETED
  CANCELLED
}

/// Why a generated visit sits on the date it does.
///
/// The master schedule workbook already records the days UltraKIL has booked
/// with each customer. BOOKED means the date came straight from one of those
/// bookings and is a fact, not a plan. ANCHORED means no booking covered the
/// period, so the date was placed near the days this agreement is usually
/// served on. SPREAD means the daily load guard moved it off a day that was
/// already full. EARLIEST is the old behaviour — no booking and no anchor to
/// aim at, so the first allowed day of the period.
enum VisitPlacement {
  BOOKED
  ANCHORED
  SPREAD
  EARLIEST
}

enum AssignmentStatus {
  DRAFT
  PROPOSED
  PUBLISHED
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  /// Replaced by a later published schedule. Kept, never deleted: a published
  /// schedule is a record of what the crews were told, and rewriting history
  /// is how a dispute becomes unanswerable.
  SUPERSEDED
}

/// The two safe outcomes for correcting already-published work. Published
/// predecessors are retained in both cases; replacement adds a successor,
/// while withdrawal returns the visit to the unassigned queue.
enum AssignmentRepairAction {
  REPLACED
  WITHDRAWN
}

enum PublishedAssignmentRepairCommunicationState {
  APPLIED_PENDING_COMMUNICATION
  COMMUNICATION_CONFIRMED
}

enum CrewRole {
  SUPERVISOR
  TECHNICIAN
  DRIVER
  HELPER
}

/// What a manager has pinned. Locks survive re-runs of the scheduler.
enum LockScope {
  FULL
  CREW
  /// The supervisor specifically, leaving the rest of the crew free to change.
  /// Distinct from CREW because a manager often cares who is in charge without
  /// caring who else goes.
  SUPERVISOR
  VEHICLE
  TIME
}

enum ScheduleRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  /// A published run replaced by a later one covering the same work.
  SUPERSEDED
}

/// Who a portal account is. Phase 1 needs only these two: a manager runs the
/// day-to-day board, an admin may also change the workforce records themselves.
enum UserRole {
  ADMIN
  MANAGER
}

/// Why an employee is unavailable. Recorded as absence periods rather than
/// "available" ones: staff are available by default, and absence is the
/// exception worth writing down.
enum AvailabilityKind {
  LEAVE
  SICK
  TRAINING
  OTHER
}

enum ScheduleRunTrigger {
  MANUAL
  AGREEMENT_CHANGE
  SCHEDULED_JOB
  MANAGER_OVERRIDE
}

/// Delivery systems supported for scheduling runs. The outbox keeps the
/// provider-neutral intent durable even when publishing succeeds but the API
/// process dies before it records the remote message id.
enum ScheduleRunDispatchProvider {
  BULLMQ
  QSTASH
}

enum ScheduleRunDispatchStatus {
  PENDING
  PUBLISHED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Organisation
// ---------------------------------------------------------------------------

model Branch {
  id        String     @id @default(uuid()) @db.Uuid
  code      BranchCode @unique
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  employees         Employee[]
  vehicles          Vehicle[]
  customers         Customer[]
  serviceSites      ServiceSite[]
  serviceAgreements ServiceAgreement[]
  generatedVisits   GeneratedVisit[]
  assignments       Assignment[]

  @@map("branches")
}

// ---------------------------------------------------------------------------
// Portal accounts
// ---------------------------------------------------------------------------

/// A person who signs in to the manager portal.
///
/// Deliberately separate from Employee. Most of the 37 people in the workforce
/// matrix will never log in, and the handful who do are identified by an email
/// and a password rather than by a row in a spreadsheet. Conflating the two
/// would mean every technician needed an account.
model User {
  id String @id @default(uuid()) @db.Uuid

  email        String @unique
  passwordHash String
  fullName     String

  role UserRole @default(MANAGER)

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Workforce
// ---------------------------------------------------------------------------

model Employee {
  id String @id @default(uuid()) @db.Uuid

  /// Stable natural key derived from the workforce matrix row. The seed importer
  /// upserts on this, which is what makes re-importing idempotent.
  sourceKey String @unique

  /// Employee number from the matrix when the source provides one.
  employeeCode String? @unique

  /// Name exactly as spelled in the source workbook.
  fullName String

  /// Grade exactly as spelled in the source workbook (e.g. "Senior PMS", "APMS").
  gradeLabel String

  /// True when gradeLabel is one of the PMS-grade supervisor grades:
  /// Senior PMS, PMS, Assistant PMS, SPMS, APMS. Every job needs at least one.
  isPmsGrade Boolean @default(false)

  branchId   String     @db.Uuid
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  branchCode BranchCode

  deploymentType DeploymentType @default(MOBILE)

  /// True when the matrix check-marks this employee under "Public Vehicles",
  /// meaning they can reach a site by bus or other public transport. Relevant
  /// to scheduling: such a crew can be sent somewhere with no company vehicle.
  /// This is not a vehicle authorization — there is no vehicle to authorise.
  canUsePublicTransport Boolean @default(false)

  /// Site name as written in the workforce matrix for permanently stationed
  /// staff, e.g. "Lion Brewery". The matrix names the site but not the customer
  /// it belongs to, so the import cannot create a ServiceSite without inventing
  /// a customer. This holds the label until the real site exists (ULK-C03), at
  /// which point a PermanentAssignment links them properly.
  permanentSiteLabel String?

  isActive Boolean @default(true)

  /// Untouched copy of the source row, for traceability of the import.
  sourceRow Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  skills                    EmployeeSkill[]
  availability              EmployeeAvailability[]
  permanentAssignments      PermanentAssignment[]
  vehicleAuthorizations     VehicleAuthorization[]
  crewMemberships           AssignmentCrewMember[]
  drivenAssignmentVehicles  AssignmentVehicle[]            @relation("AssignmentVehicleDriver")
  notificationOutboxEntries AssignmentNotificationOutbox[]

  @@index([branchId, isActive])
  @@index([isPmsGrade, branchCode])
  @@map("employees")
}

model EmployeeSkill {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Normalised code used for matching, e.g. FUMIGATION.
  skillCode  String
  /// Label exactly as spelled in the source workbook.
  skillLabel String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, skillCode])
  @@index([skillCode])
  @@map("employee_skills")
}

/// A period during which an employee is NOT available for work.
///
/// Stored as absences rather than availabilities because staff are available by
/// default; recording every working day for 37 people would be thousands of
/// rows saying "yes". Both dates are inclusive.
model EmployeeAvailability {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Inclusive. A single day off has startDate == endDate.
  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  kind   AvailabilityKind @default(LEAVE)
  reason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Overlapping periods for one employee are rejected in the service layer —
  // PostgreSQL can express that with an exclusion constraint, but Prisma cannot
  // declare one, and a silent partial guard is worse than an explicit check.
  @@index([employeeId, startDate, endDate])
  @@map("employee_availability")
}

/// An employee permanently stationed at one customer site. Such an employee is
/// never dispatched elsewhere, and never counts towards mobile crew capacity.
model PermanentAssignment {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  serviceSiteId String      @db.Uuid
  serviceSite   ServiceSite @relation(fields: [serviceSiteId], references: [id], onDelete: Cascade)

  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, serviceSiteId, effectiveFrom])
  @@index([serviceSiteId])
  @@map("permanent_assignments")
}

// ---------------------------------------------------------------------------
// Vehicles
// ---------------------------------------------------------------------------

model Vehicle {
  id String @id @default(uuid()) @db.Uuid

  /// Vehicle identifier as it appears as a column header in the matrix.
  code  String @unique
  label String

  branchId String? @db.Uuid
  branch   Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  /// Number of crew the vehicle can carry. Null when the source does not say.
  seatCapacity Int?

  /// Workbook column group, e.g. Personal or Transport Company. The matrix
  /// states this ownership grouping but never a branch; the Technician Matrix
  /// importer defaults every vehicle it writes to Colombo on both create and
  /// update (Technical Director decision, 2026-09-21). branchId stays
  /// nullable for a vehicle created outside that importer.
  ownershipGroup String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorizations     VehicleAuthorization[]
  assignmentVehicles AssignmentVehicle[]

  @@map("vehicles")
}

/// A checkmark in the matrix: this employee is authorised to drive this vehicle.
/// This is an authorisation only — it implies no ownership and no primary driver.
model VehicleAuthorization {
  id String @id @default(uuid()) @db.Uuid

  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, vehicleId])
  @@index([vehicleId])
  @@map("vehicle_authorizations")
}

// ---------------------------------------------------------------------------
// Customers and sites
// ---------------------------------------------------------------------------

model Customer {
  id String @id @default(uuid()) @db.Uuid

  name         String
  customerCode String? @unique

  branchId   String     @db.Uuid
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  branchCode BranchCode

  contactName  String?
  contactPhone String?
  contactEmail String?

  isActive Boolean @default(true)

  /// Set when an import read this record as no longer serviced — a red row in
  /// the master schedule. It is what stops the next import quietly switching
  /// the record back on: a row that has since lost its red is not evidence the
  /// client returned, only that someone changed a fill. Reactivating is a
  /// deliberate act, not a side effect of re-running the importer.
  importedInactiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceSites      ServiceSite[]
  serviceAgreements ServiceAgreement[]

  @@index([branchId, isActive])
  @@map("customers")
}

model ServiceSite {
  id String @id @default(uuid()) @db.Uuid

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name        String
  addressLine String?
  city        String?

  branchId         String               @db.Uuid
  branch           Branch               @relation(fields: [branchId], references: [id], onDelete: Restrict)
  branchCode       BranchCode
  branchConfidence SiteBranchConfidence @default(UNCERTAIN)
  branchSource     SiteBranchSource     @default(FALLBACK_DEFAULT)

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  isActive Boolean @default(true)

  /// Set when an import read this record as no longer serviced — a red row in
  /// the master schedule. It is what stops the next import quietly switching
  /// the record back on: a row that has since lost its red is not evidence the
  /// client returned, only that someone changed a fill. Reactivating is a
  /// deliberate act, not a side effect of re-running the importer.
  importedInactiveAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  operatingHours       SiteOperatingHours[]
  permanentAssignments PermanentAssignment[]
  serviceAgreements    ServiceAgreement[]

  @@index([customerId])
  @@index([branchId, isActive])
  @@map("service_sites")
}

/// Opening / service hours vary per site and per weekday. A weekday with no row
/// is closed. Minutes are stored as minutes-from-midnight to keep comparisons
/// timezone-free.
model SiteOperatingHours {
  id String @id @default(uuid()) @db.Uuid

  serviceSiteId String      @db.Uuid
  serviceSite   ServiceSite @relation(fields: [serviceSiteId], references: [id], onDelete: Cascade)

  weekday Weekday

  opensAtMinute  Int
  closesAtMinute Int
  /// Actual hours are manager-entered facts. No row is fabricated for the
  /// master schedule's missing hours; the generation fallback is recorded on
  /// GeneratedVisit instead.
  provenance     DataProvenance @default(MANAGER_CONFIRMED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A weekday may have several windows — a site that closes over lunch is two
  // rows, not one long one. Absence of any row for a weekday still means
  // closed. Non-overlap within a weekday is enforced in the service layer:
  // Prisma cannot declare the exclusion constraint that would express it, and
  // a half-expressed guard is worse than an explicit check.
  @@index([serviceSiteId, weekday])
  @@map("site_operating_hours")
}

// ---------------------------------------------------------------------------
// Services
// ---------------------------------------------------------------------------

model JobType {
  id String @id @default(uuid()) @db.Uuid

  code String @unique
  name String

  defaultDurationMinutes Int     @default(60)
  defaultCrewSize        Int     @default(2)
  /// Phase 1 rule: every job needs a PMS-grade supervisor. Kept as a column so a
  /// future job type can be configured without a migration.
  requiresPmsSupervisor  Boolean @default(true)
  /// Normalised skill code a crew member must hold, when the job type needs one.
  requiredSkillCode      String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  serviceAgreements ServiceAgreement[]

  @@map("job_types")
}

model ServiceAgreement {
  id String @id @default(uuid()) @db.Uuid

  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  serviceSiteId String      @db.Uuid
  serviceSite   ServiceSite @relation(fields: [serviceSiteId], references: [id], onDelete: Cascade)

  jobTypeId String  @db.Uuid
  jobType   JobType @relation(fields: [jobTypeId], references: [id], onDelete: Restrict)

  branchId   String     @db.Uuid
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  branchCode BranchCode

  /// N visits per (frequencyInterval x frequencyUnit).
  frequencyCount Int
  frequencyUnit  FrequencyUnit

  /// How many units make up one cycle. 1 is the ordinary case — "twice a week"
  /// is count 2, unit WEEK, interval 1. The interval is what lets the model
  /// hold the cycles UltraKIL actually sells: fortnightly is 1 per 2 WEEKs and
  /// quarterly is 1 per 3 MONTHs, neither of which is expressible as a whole
  /// number of visits per single week or month.
  frequencyInterval Int @default(1)

  /// Crew size is variable per agreement.
  crewSize           Int
  durationMinutes    Int
  crewSizeProvenance DataProvenance @default(UNKNOWN)
  durationProvenance DataProvenance @default(UNKNOWN)
  dayRuleProvenance  DataProvenance @default(UNKNOWN)

  /// Service window within the day, as minutes from midnight. Null falls back to
  /// the site's operating hours for that weekday.
  serviceWindowStartMinute Int?
  serviceWindowEndMinute   Int?

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  status AgreementStatus @default(ACTIVE)

  /// Equivalent to Customer/ServiceSite.importedInactiveAt. An agreement read
  /// from a red cell remains archived until a person explicitly clears this
  /// marker; removing a fill on re-import is not evidence that work resumed.
  importedInactiveAt DateTime?

  /// Bumped on every change that alters what visits this agreement produces.
  /// A generated visit records the version it came from, so a schedule stays
  /// explainable after the agreement moves on.
  currentVersion Int @default(1)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dayRules        ServiceAgreementDayRule[]
  requiredSkills  ServiceAgreementRequiredSkill[]
  versions        ServiceAgreementVersion[]
  generatedVisits GeneratedVisit[]
  bookings        ServiceAgreementBooking[]

  @@index([customerId])
  @@index([serviceSiteId])
  @@index([branchId, status])
  @@map("service_agreements")
}

/// A date the workbook has already booked with the customer.
///
/// The master schedule's twelve month columns hold the day numbers UltraKIL
/// has agreed with each client — "10", or "5 & 20". Until now those numbers
/// were read only to infer which weekdays a site is serviced on and then
/// thrown away, so generation re-planned every visit from the frequency and
/// piled the whole month onto its first allowed weekday. A booked date is a
/// commitment, not a suggestion: it is kept here so generation can place the
/// visit where the customer is actually expecting it.
///
/// `provenance` is SOURCE for a date read from the workbook. A re-import
/// replaces only its own SOURCE rows — anything a manager entered stays.
model ServiceAgreementBooking {
  id String @id @default(uuid()) @db.Uuid

  serviceAgreementId String           @db.Uuid
  serviceAgreement   ServiceAgreement @relation(fields: [serviceAgreementId], references: [id], onDelete: Cascade)

  /// The booked calendar date, in Asia/Colombo terms.
  bookedDate DateTime @db.Date

  provenance DataProvenance @default(SOURCE)

  createdAt DateTime @default(now())

  @@unique([serviceAgreementId, bookedDate])
  @@index([serviceAgreementId])
  @@map("service_agreement_bookings")
}

/// A skill a crew member must hold for this agreement's work.
///
/// The job type carries a default, but a particular customer can need more —
/// a site that also wants fumigation cover, say. Held per agreement so the
/// requirement travels with the commitment, not the category.
model ServiceAgreementRequiredSkill {
  id String @id @default(uuid()) @db.Uuid

  serviceAgreementId String           @db.Uuid
  serviceAgreement   ServiceAgreement @relation(fields: [serviceAgreementId], references: [id], onDelete: Cascade)

  /// Normalised code, matching EmployeeSkill.skillCode.
  skillCode String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceAgreementId, skillCode])
  @@index([skillCode])
  @@map("service_agreement_required_skills")
}

/// An immutable snapshot of an agreement as it stood at one version.
///
/// Visits are generated from an agreement that may later change. Without a
/// snapshot, "why was this visit on a Tuesday?" becomes unanswerable the
/// moment someone edits the allowed days. Append-only: rows are never updated.
model ServiceAgreementVersion {
  id String @id @default(uuid()) @db.Uuid

  serviceAgreementId String           @db.Uuid
  serviceAgreement   ServiceAgreement @relation(fields: [serviceAgreementId], references: [id], onDelete: Cascade)

  versionNumber Int

  /// The agreement's scheduling-relevant fields as they were at this version.
  snapshot Json

  /// Who caused this version, for the same reason the audit log records it.
  changedByUserId String?
  changedByLabel  String?
  changeSummary   String?

  createdAt DateTime @default(now())

  generatedVisits GeneratedVisit[]

  @@unique([serviceAgreementId, versionNumber])
  @@index([serviceAgreementId, createdAt])
  @@map("service_agreement_versions")
}

/// Which weekdays an agreement may be served on.
///
/// ALLOWED rows are hard constraints — a visit may only fall on an allowed day.
/// PREFERRED rows are soft preferences used for ranking, never for exclusion.
model ServiceAgreementDayRule {
  id String @id @default(uuid()) @db.Uuid

  serviceAgreementId String           @db.Uuid
  serviceAgreement   ServiceAgreement @relation(fields: [serviceAgreementId], references: [id], onDelete: Cascade)

  weekday Weekday
  kind    DayRuleKind

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([serviceAgreementId, weekday, kind])
  @@map("service_agreement_day_rules")
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

/// One concrete visit generated from a service agreement's frequency rules.
/// A visit exists whether or not it can be staffed; an unstaffable visit stays
/// UNASSIGNED with explanatory reasons rather than being quietly dropped.
model GeneratedVisit {
  id String @id @default(uuid()) @db.Uuid

  serviceAgreementId String           @db.Uuid
  serviceAgreement   ServiceAgreement @relation(fields: [serviceAgreementId], references: [id], onDelete: Cascade)

  branchId   String     @db.Uuid
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  branchCode BranchCode

  /// Calendar date of the visit, in Asia/Colombo terms.
  visitDate DateTime @db.Date

  /// Permitted window on that date, minutes from midnight.
  windowStartMinute Int
  windowEndMinute   Int

  durationMinutes  Int
  requiredCrewSize Int
  /// Whether this visit window came from actual site hours or the disclosed
  /// 08:00-17:00 fallback used when no actual hours are recorded.
  windowProvenance DataProvenance @default(UNKNOWN)

  status VisitStatus @default(PENDING)

  /// Why the visit sits on this date: straight from a customer booking, near
  /// the agreement's usual days, moved off a full day by the load guard, or
  /// simply the first allowed day. EARLIEST is the honest default for rows
  /// generated before placement was recorded — that is what they were.
  placement VisitPlacement @default(EARLIEST)

  /// True once a manager has changed this visit by hand — moved its date,
  /// widened its window, altered the crew size. Regeneration must never
  /// overwrite one: the manager knows something the agreement does not.
  isManuallyAdjusted Boolean   @default(false)
  manuallyAdjustedAt DateTime?
  manuallyAdjustedBy String?

  /// A manager's pin. A locked visit survives regeneration untouched, whatever
  /// the agreement now says. Null means unlocked.
  lockedAt       DateTime?
  lockedByUserId String?
  lockReason     String?

  /// Which generation run produced this visit.
  generatedByRunId String?      @db.Uuid
  generatedByRun   ScheduleRun? @relation("ScheduleRunGeneratedVisits", fields: [generatedByRunId], references: [id], onDelete: SetNull)

  /// The agreement version this visit was generated from, so the visit stays
  /// explainable after the agreement changes. Populated by ULK-C04.
  agreementVersionId String?                  @db.Uuid
  agreementVersion   ServiceAgreementVersion? @relation(fields: [agreementVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments        Assignment[]
  unassignedReasons  VisitUnassignedReason[]
  repairItems        PublishedAssignmentRepairItem[]
  coverageShortfalls DayCoverageShortfall[]

  // Idempotency: one visit per agreement, date and start time. Generating the
  // same horizon twice therefore updates rather than duplicating.
  @@unique([serviceAgreementId, visitDate, windowStartMinute])
  @@index([branchId, visitDate, status])
  @@index([status])
  @@index([serviceAgreementId, visitDate])
  /// The load guard reads every visit standing in a branch's horizon on every
  /// generation run, by branch code and date. Without this it is a sequential
  /// scan of the whole table each time.
  @@index([branchCode, visitDate])
  @@map("generated_visits")
}

/// Why a visit could not be staffed. Populated by the eligibility and conflict
/// engine (ULK-C05); defined here so the queue has a stable shape from day one.
model VisitUnassignedReason {
  id String @id @default(uuid()) @db.Uuid

  generatedVisitId String         @db.Uuid
  generatedVisit   GeneratedVisit @relation(fields: [generatedVisitId], references: [id], onDelete: Cascade)

  /// Stable machine-readable code, e.g. NO_PMS_SUPERVISOR_AVAILABLE.
  code    String
  /// Manager-facing explanation.
  message String
  details Json?

  scheduleRunId String?      @db.Uuid
  scheduleRun   ScheduleRun? @relation(fields: [scheduleRunId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([generatedVisitId])
  @@index([code])
  @@map("visit_unassigned_reasons")
}

/// A crew and vehicle proposal for one visit.
model Assignment {
  id String @id @default(uuid()) @db.Uuid

  generatedVisitId String         @db.Uuid
  generatedVisit   GeneratedVisit @relation(fields: [generatedVisitId], references: [id], onDelete: Cascade)

  branchId   String     @db.Uuid
  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  branchCode BranchCode

  status AssignmentStatus @default(DRAFT)

  plannedStart DateTime
  plannedEnd   DateTime

  scheduleRunId String?      @db.Uuid
  scheduleRun   ScheduleRun? @relation(fields: [scheduleRunId], references: [id], onDelete: SetNull)

  publishedAt DateTime?

  /// Phase 2 hooks — the worker app will populate these. Unused in Phase 1.
  acknowledgedAt DateTime?
  startedAt      DateTime?
  completedAt    DateTime?

  /// Assignment-level published lineage. A correction points at the exact
  /// published predecessor it supersedes; the predecessor itself is immutable.
  supersedesAssignmentId String?     @unique @db.Uuid
  supersedesAssignment   Assignment? @relation("AssignmentSupersession", fields: [supersedesAssignmentId], references: [id], onDelete: Restrict)
  supersededByAssignment Assignment? @relation("AssignmentSupersession")

  publishedByRepairId String?                    @db.Uuid
  publishedByRepair   PublishedAssignmentRepair? @relation("RepairPublishedAssignments", fields: [publishedByRepairId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  crewMembers               AssignmentCrewMember[]
  vehicles                  AssignmentVehicle[]
  locks                     AssignmentLock[]
  notificationOutboxEntries AssignmentNotificationOutbox[]
  repairItemsAsSource       PublishedAssignmentRepairItem[] @relation("RepairSourceAssignment")
  repairItemAsReplacement   PublishedAssignmentRepairItem?  @relation("RepairReplacementAssignment")

  @@index([branchId, status])
  @@index([generatedVisitId])
  @@index([plannedStart])
  @@index([publishedByRepairId])
  @@map("assignments")
}

/// One administrator-confirmed, idempotent repair transaction. The request
/// and result hashes make retries safe without rewriting published history.
model PublishedAssignmentRepair {
  id String @id @default(uuid()) @db.Uuid

  idempotencyKey String @unique
  requestHash    String
  planHash       String
  reason         String

  actorUserId String
  actorLabel  String

  result Json

  communicationState       PublishedAssignmentRepairCommunicationState @default(APPLIED_PENDING_COMMUNICATION)
  communicationConfirmedAt DateTime?

  createdAt DateTime @default(now())

  items                        PublishedAssignmentRepairItem[]
  publishedAssignments         Assignment[]                    @relation("RepairPublishedAssignments")
  cancelledNotificationIntents AssignmentNotificationOutbox[]  @relation("OutboxCancelledByRepair")

  @@index([createdAt])
  @@map("published_assignment_repairs")
}

/// Immutable before/after evidence for one assignment in a repair batch.
model PublishedAssignmentRepairItem {
  id String @id @default(uuid()) @db.Uuid

  repairId String                    @db.Uuid
  repair   PublishedAssignmentRepair @relation(fields: [repairId], references: [id], onDelete: Restrict)

  sourceAssignmentId String     @unique @db.Uuid
  sourceAssignment   Assignment @relation("RepairSourceAssignment", fields: [sourceAssignmentId], references: [id], onDelete: Restrict)

  replacementAssignmentId String?     @unique @db.Uuid
  replacementAssignment   Assignment? @relation("RepairReplacementAssignment", fields: [replacementAssignmentId], references: [id], onDelete: Restrict)

  generatedVisitId  String                 @db.Uuid
  generatedVisit    GeneratedVisit         @relation(fields: [generatedVisitId], references: [id], onDelete: Restrict)
  action            AssignmentRepairAction
  sourceFingerprint String

  before Json
  after  Json

  createdAt DateTime @default(now())

  @@unique([repairId, sourceAssignmentId])
  @@index([generatedVisitId])
  @@map("published_assignment_repair_items")
}

/// One administrator-confirmed, idempotent bunching-repair batch: the
/// preview→review→apply ledger the Technical Director's review asked for,
/// mirroring `PublishedAssignmentRepair`'s request/plan-hash pattern. A
/// bunching repair only ever moves an agreement's own unbooked
/// `GeneratedVisit` rows through the same scoped `confirm` ordinary
/// generation already uses, which writes and protects each visit
/// individually — so, unlike an assignment repair, no separate before/after
/// item table is needed; the applied summary is recorded whole, in `result`.
/// Where one bunching-repair apply got to.
///
/// The row is written *before* the first move, so the key is claimed by
/// whoever starts rather than by whoever finishes. That is what makes a
/// partial apply impossible to lose: a crash between two moves leaves an
/// IN_PROGRESS row naming exactly what had already landed.
enum RepairBunchingStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

model RepairBunchingBatch {
  id String @id @default(uuid()) @db.Uuid

  idempotencyKey String  @unique
  requestHash    String
  planHash       String
  reason         String?

  actorUserId String
  actorLabel  String

  status RepairBunchingStatus @default(IN_PROGRESS)

  /// Every move that has actually landed, appended as each one commits, so
  /// the ledger is never behind the calendar. Written even when the apply
  /// later fails: an unrecorded partial repair is the one outcome this
  /// table exists to rule out.
  appliedMoves Json @default("[]")

  /// Only once the whole plan has been applied. Null while in progress, and
  /// on a failure — there is no complete result to replay in either case.
  result Json?

  failureReason String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([createdAt])
  @@index([status])
  @@map("repair_bunching_batches")
}

model AssignmentCrewMember {
  id String @id @default(uuid()) @db.Uuid

  assignmentId String     @db.Uuid
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  role CrewRole @default(TECHNICIAN)

  /// Denormalised at assignment time so the "at least one PMS supervisor" rule
  /// can be checked without joining Employee, and so history stays truthful if a
  /// grade changes later.
  isPmsSupervisor Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, employeeId])
  @@index([employeeId])
  @@map("assignment_crew_members")
}

model AssignmentVehicle {
  id String @id @default(uuid()) @db.Uuid

  assignmentId String     @db.Uuid
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  vehicleId String  @db.Uuid
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  /// The crew member who will drive. Must hold a VehicleAuthorization for this
  /// vehicle — enforced by the eligibility engine, not by the database.
  driverEmployeeId String?   @db.Uuid
  driverEmployee   Employee? @relation("AssignmentVehicleDriver", fields: [driverEmployeeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, vehicleId])
  @@index([vehicleId])
  @@map("assignment_vehicles")
}

/// A manager pin. Re-running the scheduler must preserve locked decisions.
/// A lock can never make an invalid assignment valid — hard rules still apply.
model AssignmentLock {
  id String @id @default(uuid()) @db.Uuid

  assignmentId String     @db.Uuid
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  scope LockScope @default(FULL)

  lockedByUserId String?
  reason         String?

  releasedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([assignmentId, scope])
  @@index([assignmentId])
  @@map("assignment_locks")
}

/// One invocation of visit generation or of the scheduling optimizer.
model ScheduleRun {
  id String @id @default(uuid()) @db.Uuid

  status  ScheduleRunStatus  @default(QUEUED)
  trigger ScheduleRunTrigger @default(MANUAL)

  branchCode BranchCode?

  /// Inclusive date range the run covers.
  rangeStart DateTime @db.Date
  rangeEnd   DateTime @db.Date

  requestedByUserId String?

  /// Counters filled in as the run progresses.
  visitsConsidered Int @default(0)
  visitsScheduled  Int @default(0)
  visitsUnassigned Int @default(0)

  startedAt  DateTime?
  finishedAt DateTime?

  errorCode    String?
  errorMessage String?

  /// 0-100, updated as the run works. A solve can take seconds; a manager
  /// watching a spinner with no number assumes it has hung.
  progressPercent Int @default(0)

  /// BullMQ or QStash delivery id, so a queued run can be found and cancelled.
  jobId String?

  /// The requested per-day solver limit is persisted because QStash messages
  /// intentionally carry only this row's opaque ID.
  timeLimitSeconds Int @default(20)

  /// At-least-once queue deliveries can overlap. Only the holder of this lease
  /// may advance, finish or fail the run; an expired lease can be recovered.
  executionLeaseId        String?   @db.Uuid
  executionLeaseExpiresAt DateTime?
  executionAttempt        Int       @default(0)

  /// Set when a manager asks to stop. The worker checks it at each safe point
  /// and abandons the run without writing, rather than being killed mid-write.
  cancelRequestedAt DateTime?

  /// Publishing freezes the run: its assignments become the schedule the crews
  /// were told, and neither they nor this row may change afterwards.
  publishedAt       DateTime?
  publishedByUserId String?

  /// The later run that replaced this one.
  supersededByRunId String?       @db.Uuid
  supersededBy      ScheduleRun?  @relation("ScheduleRunSupersession", fields: [supersededByRunId], references: [id], onDelete: SetNull)
  superseded        ScheduleRun[] @relation("ScheduleRunSupersession")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  generatedVisits   GeneratedVisit[]           @relation("ScheduleRunGeneratedVisits")
  assignments       Assignment[]
  unassignedReasons VisitUnassignedReason[]
  auditEvents       AuditEvent[]
  dayCoverage       DayCoverage[]
  dispatchOutbox    ScheduleRunDispatchOutbox?

  @@index([status, createdAt])
  @@index([executionLeaseExpiresAt])
  @@map("schedule_runs")
}

/// A durable, provider-neutral request to deliver one schedule run. `id` is
/// also QStash's opaque deduplication id, so a publish acknowledgement lost
/// before `messageId` is persisted can be safely published again.
model ScheduleRunDispatchOutbox {
  id String @id @default(uuid()) @db.Uuid

  scheduleRunId String      @unique @db.Uuid
  scheduleRun   ScheduleRun @relation(fields: [scheduleRunId], references: [id], onDelete: Cascade)

  provider ScheduleRunDispatchProvider
  status   ScheduleRunDispatchStatus   @default(PENDING)

  messageId     String?
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  lastError     String?

  /// A signed QStash failure callback is recorded before the active lease is
  /// touched. If that lease is still live, the callback can retry without
  /// losing the terminal-delivery fact.
  terminalFailureMessageId String?
  terminalFailureCode      String?
  terminalFailureMessage   String?
  terminalFailureAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, updatedAt])
  @@map("schedule_run_dispatch_outbox")
}

/// A record of a future assignment notification — written when a schedule is
/// published, read by nothing yet. This is the outbox ULK-C07 asks for: Phase 1
/// does not send notifications, but Phase 2's worker app and push delivery can
/// be built by adding a consumer that marks rows `processedAt`, without any
/// change to how publishing writes them.
model AssignmentNotificationOutbox {
  id String @id @default(uuid()) @db.Uuid

  assignmentId String     @db.Uuid
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  employeeId String   @db.Uuid
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// e.g. "assignment.published". Kept as free text like AuditEvent.action so a
  /// new event type needs no migration.
  eventType String

  /// Everything a future notification would need to say, snapshotted at publish
  /// time so it reads correctly even if the employee or visit later changes.
  payload Json

  createdAt DateTime @default(now())

  /// Null until a future consumer sends the notification. No consumer exists in
  /// Phase 1 — this column exists so adding one needs no migration either.
  processedAt DateTime?

  /// A published intent made obsolete by a repair is retained as evidence but
  /// must never be delivered. Database constraints keep this terminal state
  /// mutually exclusive with successful processing.
  cancelledAt         DateTime?
  cancelledByRepairId String?                    @db.Uuid
  cancelledByRepair   PublishedAssignmentRepair? @relation("OutboxCancelledByRepair", fields: [cancelledByRepairId], references: [id], onDelete: Restrict)

  @@unique([assignmentId, employeeId, eventType])
  @@index([processedAt])
  @@index([cancelledAt])
  @@index([employeeId])
  @@map("assignment_notification_outbox")
}

/// Append-only operations history. Every manager override, lock and publish is
/// recorded here so the dispatch board can show who changed what and when.
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid

  /// e.g. "Assignment", "GeneratedVisit", "ServiceAgreement".
  entityType String
  entityId   String @db.Uuid
  /// e.g. "assignment.published", "assignment.crew_replaced".
  action     String

  actorUserId String?
  actorLabel  String?

  before Json?
  after  Json?

  scheduleRunId String?      @db.Uuid
  scheduleRun   ScheduleRun? @relation(fields: [scheduleRunId], references: [id], onDelete: SetNull)

  correlationId String?

  createdAt DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// Rolling 30-day coverage (ULK-C13)
// ---------------------------------------------------------------------------

/// What the daily replenishment decided about one branch-day.
///
/// These names are the manager's, not the job's, because this state is what
/// the portal renders and what ULK-O13/O14 read. The approved policy is:
/// prepare automatically; publish automatically only when the whole due set
/// passes every hard rule AND the existing publication gate is READY with
/// confirmed provenance; otherwise publish nothing and alert a manager. The
/// outcomes below are that policy enumerated.
///
/// The distinction between PREPARED_AWAITING_MANAGER and COVERED_PUBLISHED is
/// load-bearing and must never be collapsed. `CalendarService`'s
/// `CALENDAR_STATUSES` (calendar/calendar.service.ts:14) includes DRAFT and
/// PROPOSED, so a prepared day already looks fully crewed on the Calendar
/// while nothing has been published. A crew/vehicle summary is not
/// publication proof; only COVERED_PUBLISHED is.
enum DayCoverageState {
  /// Claimed, attempt in flight. Persisting past `claimExpiresAt` means the
  /// worker died, not that the work is slow.
  IN_PROGRESS

  /// No visit was due. A quiet day is covered, not a failure.
  ///
  /// Only reachable when generation is known to have covered this date for
  /// every agreement that could place work on it. "No visits exist" on its
  /// own does not mean nothing is due; it can equally mean nothing has been
  /// generated yet, and those must never resolve to the same answer.
  NOTHING_DUE

  /// Demand may exist but generation has not reached this date yet, so
  /// whether anything is due is unknown rather than no.
  ///
  /// Recorded as its own state rather than folded into NOTHING_DUE because a
  /// day nobody has planned and a day with genuinely nothing on it look
  /// identical in `generated_visits` and are opposite facts. Leaving it
  /// explicitly unverified is the honest answer until the horizon sweep has
  /// caught up.
  AWAITING_GENERATION

  /// Every due visit was staffed and published automatically: the gate
  /// returned READY on confirmed provenance with no shortfall.
  COVERED_PUBLISHED

  /// Every due visit was staffed, but publication needs a real manager —
  /// today that is every day carrying work, because no service window or site
  /// branch in the database is confirmed yet. Drafts are staged and waiting.
  /// The manager acknowledges the displayed warnings and gives a reason; the
  /// worker never supplies either.
  PREPARED_AWAITING_MANAGER

  /// At least one due visit could not be staffed compliantly, so nothing for
  /// this day was published. `shortfalls` says which visits and why.
  SHORTFALL

  /// The due set changed after this day was resolved — a new agreement, or an
  /// agreement edited into this date. The day must be prepared again. A
  /// coverage row is a record of one evaluation, never a permanent claim that
  /// the day is finished.
  STALE

  /// The attempt errored. Separate from SHORTFALL: a shortfall is an answer
  /// about the schedule, this is an answer about the job.
  FAILED
}

/// One branch-day of the rolling window, and what replenishment made of it.
///
/// A day inside the window with no row here is UNCHECKED — never evaluated.
/// That is deliberately the absence of a row rather than a seventh state, so
/// a day cannot be silently reported as checked by a row nobody wrote.
///
/// The unique key is the mutual exclusion: two replenishers racing the same
/// day both insert, one wins, the other stops. A status column read and then
/// written would be a read-modify-write with a race inside it.
model DayCoverage {
  id String @id @default(uuid()) @db.Uuid

  branchCode BranchCode

  /// The civil date in Asia/Colombo, matching `GeneratedVisit.visitDate`.
  /// Resolved through the configured-zone helper, never from a UTC instant:
  /// `toDateOnly()` returns the UTC date and the app runs at UTC+5:30, so
  /// between local midnight and 05:30 it names the previous day.
  coverageDate DateTime @db.Date

  state DayCoverageState @default(IN_PROGRESS)

  /// Visits due when the attempt read them, and how many ended up staffed.
  /// Equal on every state except SHORTFALL, STALE and FAILED.
  visitsDue     Int @default(0)
  visitsStaffed Int @default(0)

  /// What this evaluation was made against. Two fingerprints, because
  /// coverage has two preconditions and one hash cannot express both.
  ///
  /// `demandDigest` covers the agreements that could place work on this date:
  /// each active agreement's id, currentVersion and updatedAt, hashed. It
  /// catches demand that does not exist as a visit yet — a new agreement
  /// whose due visit generation has not produced, which no digest over visit
  /// ids can see, because there is no id to hash.
  ///
  /// `supplyDigest` covers what is actually on the date: each due visit's id,
  /// status and updatedAt, and each assignment's id, status and updatedAt. It
  /// catches an edit to a visit or an assignment that leaves the set of ids
  /// identical — a changed duration, crew size, window or lock — which an
  /// id-only digest would read as unchanged.
  ///
  /// Reconciliation recomputes both. Either mismatching moves the day to
  /// STALE. A demand mismatch means generation must run again before the day
  /// can be re-prepared; a supply mismatch means only re-preparation is
  /// needed. Null while IN_PROGRESS, before the first read completes.
  demandDigest String?
  supplyDigest String?

  /// The run that staffed the day, once there is one.
  scheduleRunId String?      @db.Uuid
  scheduleRun   ScheduleRun? @relation(fields: [scheduleRunId], references: [id], onDelete: SetNull)

  /// Held as a lease rather than a flag, so a worker killed mid-attempt does
  /// not strand the day: a claim past its expiry may be taken again, and
  /// `attempt` records how often that happened.
  claimedAt      DateTime @default(now())
  claimExpiresAt DateTime
  attempt        Int      @default(0)

  /// Fences the claim. A new token is minted every time the day is taken,
  /// including a takeover of an expired claim, and every state-changing step
  /// must present it.
  ///
  /// Without this, a worker whose lease expired mid-attempt still holds the
  /// row's stable id: it could finish staffing, publish, and write its
  /// outcome over the new owner's. The id says which day; only the token says
  /// which attempt, and an unattended worker needs both.
  claimToken String? @db.Uuid

  resolvedAt DateTime?

  shortfalls DayCoverageShortfall[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchCode, coverageDate])
  @@index([coverageDate, state])
  @@index([state, claimExpiresAt])
  @@map("day_coverage")
}

/// Why one due visit could not be staffed, in words a manager can act on.
///
/// A visit can fail several rules at once and a manager deserves all of them,
/// so the key is the visit and the code together, not the visit alone. Reason
/// codes reuse the existing eligibility vocabulary, so the same words appear
/// here and on Unassigned Visits.
model DayCoverageShortfall {
  id String @id @default(uuid()) @db.Uuid

  dayCoverageId String      @db.Uuid
  dayCoverage   DayCoverage @relation(fields: [dayCoverageId], references: [id], onDelete: Cascade)

  generatedVisitId String         @db.Uuid
  generatedVisit   GeneratedVisit @relation(fields: [generatedVisitId], references: [id], onDelete: Cascade)

  reasonCode String

  /// Manager-readable and free of personal data: it names the rule that could
  /// not be met, never an employee.
  message String

  createdAt DateTime @default(now())

  @@unique([dayCoverageId, generatedVisitId, reasonCode])
  @@index([generatedVisitId])
  @@map("day_coverage_shortfalls")
}
