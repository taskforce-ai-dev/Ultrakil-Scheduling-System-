{
  "name": "@ultrakil/api",
  "version": "0.1.0",
  "private": true,
  "description": "UltraKIL scheduling API (NestJS)",
  "scripts": {
    "build": "nest build",
    "start": "node scripts/with-env.mjs nest start",
    "start:dev": "node scripts/with-env.mjs nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "node scripts/with-env.mjs prisma migrate dev",
    "db:deploy": "node scripts/with-env.mjs prisma migrate deploy",
    "db:reset": "node scripts/with-env.mjs prisma migrate reset --force",
    "db:seed": "node scripts/with-env.mjs tsx prisma/seed.ts",
    "db:seed:demo": "node scripts/with-env.mjs tsx prisma/seed-demo.ts",
    "schedule:import": "node scripts/with-env.mjs tsx scripts/import-schedule.ts",
    "schedule:uncertain-branches": "node scripts/with-env.mjs tsx scripts/list-uncertain-branches.ts",
    "openapi:generate": "node scripts/with-env.mjs tsx scripts/generate-openapi.ts",
    "lint": "eslint \"{src,test,scripts,prisma}/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.js --selectProjects unit",
    "test:integration": "node scripts/with-env.mjs jest --config jest.config.js --selectProjects integration --runInBand",
    "db:status": "node scripts/with-env.mjs prisma migrate status"
  },
  "prisma": {
    "seed": "node scripts/with-env.mjs tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.2",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/swagger": "^11.1.0",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "ioredis": "^5.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "@nestjs/cli": "^11.0.5",
    "@nestjs/schematics": "^11.0.2",
    "@nestjs/testing": "^11.0.12",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.14",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "jest": "^29.7.0",
    "prisma": "^6.5.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.0",
    "tsx": "^4.19.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.28.0"
  }
}
